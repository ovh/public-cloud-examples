########################################################################################
# Mono-vRack landing zone — Day-1 (hub). Reference file: no secrets here.
# Secrets via TF_VAR_* (tofu_state_passphrase, admin_password, ha_password) and OVH API
# credentials via TF_VAR_ovh_* or a service account (OVH_CLIENT_ID / OVH_CLIENT_SECRET).
########################################################################################

compute_region  = "EU-WEST-PAR"      # default; any region already enabled on the project works
admin_client_ip = "203.0.113.42"      # your operator IP or range (AdminClients alias)

hub_flavor       = "b3-16"
opnsense_version = "26.7"
slot_count       = 20                  # spoke slots pre-provisioned on the hub (free)
hub_services     = true                # unbound + ntpd + explicit proxy on the LAN VIP
# proxy_allowed_domains = ["ubuntu.com", "debian.org", "docker.io", "pypi.org"]   # empty = any destination (always logged)
# proxy_connect_ports   = [443, 6514, 12202]                                       # CONNECT targets; 6514/12202 = log shippers → Logs Data Platform
# hub_remote_syslog     = { host = "<dedicated-input>.logs.ovh.com", port = 6514 } # hub logs (pass/block…) to LDP over TLS

# ssh_public_key_path = "~/.ssh/id_ed25519.pub"   # else generated, private key in .ssh/hub_key

# Hub networks — outside 10.0.0.0/8 (one /16 per spoke slot lives there)
hub_net_wan_vlan_id     = 100
hub_private_wan_cidr    = "172.16.0.0/24"
hub_net_lan_vlan_id     = 200                   # = transit VLAN joined by every spoke
hub_private_lan_cidr    = "192.168.10.0/24"     # slot k router = .(10+k), hub DHCP .100-.200
hub_net_hasync_vlan_id  = 199
hub_private_hasync_cidr = "172.16.254.0/30"
