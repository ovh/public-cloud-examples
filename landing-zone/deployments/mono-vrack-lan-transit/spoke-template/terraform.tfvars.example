########################################################################################
# Mono-vRack landing zone — Day-2 (one spoke). Copy this directory per spoke.
# Secrets via TF_VAR_* (tofu_state_passphrase) and OVH credentials via TF_VAR_ovh_* or a
# service account (OVH_CLIENT_ID / OVH_CLIENT_SECRET).
########################################################################################

spoke_name = "finance-qa"
slot       = 1                         # unique per spoke: 10.1.0.0/16, VLANs 1010-1019, transit .11
networks   = { app = 0, db = 1 }       # 10.1.0.0/24 and 10.1.1.0/24
# extra_egress = [{ cidr = "198.27.92.0/24", port = 443, protocol = "tcp" }]   # public whitelist, if any

# Hub facts — `tofu output spoke_inputs` on the landing zone
compute_region         = "EU-WEST-PAR"
hub_vrack_service_name = "pn-XXXXXX"
hub_lan_vlan_id        = 200
hub_lan_cidr           = "192.168.10.0/24"
hub_lan_carp_ip        = "192.168.10.99"
