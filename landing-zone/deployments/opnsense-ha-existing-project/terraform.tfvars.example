########################################################################################
# REFERENCE FILE — do not put real secrets here.
# Sensitive variables (passwords, passphrase) must be passed via TF_VAR_* environment
# variables from your secrets manager. See docs/05-security-and-secrets.md.
#
# Authentication: source the openrc.sh of an OpenStack user (administrator role) on the
# target project before running tofu. No OVH API token is needed.
########################################################################################

########################################################################################
# OpenTofu state encryption
########################################################################################

tofu_state_passphrase = "change-me-strong-passphrase"

########################################################################################
# Region
#
# 3-AZ regions — OPNsense nodes are automatically placed on separate availability zones
# (in addition to anti-affinity at the hypervisor level):
#   EU-WEST-PAR   Paris      → primary: eu-west-par-a  |  secondary: eu-west-par-b
#   EU-SOUTH-MIL  Milan      → primary: eu-south-mil-a |  secondary: eu-south-mil-b
#
# Single-AZ regions — anti-affinity at the hypervisor level only:
#   GRA9 / GRA11  Gravelines
#   SBG7          Strasbourg
#   BHS5          Beauharnois (Canada)
#   WAW1          Warsaw
#   DE1           Frankfurt
#   UK1           London
########################################################################################

region = "EU-WEST-PAR"

########################################################################################
# Instance
########################################################################################

# OPNsense release of the cloud-ready image (templates target the 26.7 configuration model)
opnsense_version = "26.7"

# Recommended flavors:
#   b3-16   — 4 vCPU  16 GB RAM   (default, suits most workloads)
#   b3-64   — 16 vCPU 64 GB RAM   (high-throughput / large rulesets)
flavor = "b3-16"

# Path to an existing SSH public key. Leave commented out to auto-generate a keypair
# (private key: `tofu output -raw ssh_private_key`).
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"

########################################################################################
# Network
# All networks are created as vRack-backed VLANs.
# VLAN IDs must not conflict with other resources in your vRack.
########################################################################################

vlan_wan    = 100
cidr_wan    = "10.1.0.0/24"

vlan_lan    = 200
cidr_lan    = "192.168.10.0/24"

vlan_hasync = 199
cidr_hasync = "10.0.254.0/30"

########################################################################################
# Firewall access
# admin_client_ip restricts WebGUI (8443) and SSH (22) access. It seeds the "AdminClients"
# alias, which you can extend later in Firewall › Aliases.
# Use your public IP or a CIDR range (e.g. "203.0.113.42" or "203.0.113.0/24").
########################################################################################

admin_client_ip = "203.0.113.42"
admin_password  = "change-me-strong-password"
ha_password     = "change-me-ha-secret"
